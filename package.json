{
  "name": "apollo-lead-extractor",
  "version": "1.0.0",
  "description": "Desktop Apollo People Search lead extraction app with dynamic DOM mapping and streaming exports.",
  "main": "dist/electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite --host 0.0.0.0",
    "dev:electron": "wait-on tcp:5173 && vite build --config vite.electron.config.ts --mode development && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "tsc -p tsconfig.json && vite build && vite build --config vite.electron.config.ts",
    "smoke:electron": "cross-env ELECTRON_SMOKE_TEST=1 electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "postinstall": "playwright install chromium"
  },
  "keywords": [
    "apollo",
    "electron",
    "playwright",
    "lead-extraction"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "latest",
    "clsx": "latest",
    "dotenv": "latest",
    "electron": "latest",
    "exceljs": "latest",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.29.0",
    "papaparse": "latest",
    "playwright": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/papaparse": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/ui": "latest",
    "autoprefixer": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "jsdom": "latest",
    "postcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
